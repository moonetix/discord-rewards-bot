# Copy to .env and fill in. Never commit .env.

# Discord Developer Portal, your app, General Information
DISCORD_PUBLIC_KEY=replace-with-the-64-hex-character-public-key
# Only needed by scripts/register-commands.js
DISCORD_APPLICATION_ID=123456789012345678
DISCORD_BOT_TOKEN=replace-with-your-bot-token
# Optional: register the commands in one server only
DISCORD_GUILD_ID=

# Public https address of your site. The earn page is SITE_URL/earn
SITE_URL=https://example.com
# Where members link Discord to their site account (your OAuth2 page)
LINK_ACCOUNT_URL=https://example.com/account

# Moonetix dashboard: Offerwalls, your offerwall, Integration
MOONETIX_APP_ID=your-app-id
MOONETIX_LINK_SALT=your-link-hash-salt
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=your-postback-secret-key

# Optional
PORT=3000
DATABASE_PATH=./data.sqlite
EARN_COOLDOWN_SECONDS=30
CURRENCY_NAME=Coins
